{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/security-review/finding.schema.json",
  "title": "Security Review Finding",
  "type": "object",
  "required": [
    "id",
    "title",
    "severity",
    "confidence",
    "status",
    "category",
    "affectedLocations",
    "description",
    "evidence",
    "exploitability",
    "impact",
    "remediation"
  ],
  "properties": {
    "id": { "type": "string" },
    "title": { "type": "string" },
    "severity": {
      "type": "string",
      "enum": ["Critical", "High", "Medium", "Low", "Informational"]
    },
    "confidence": {
      "type": "string",
      "enum": ["High", "Medium", "Low"]
    },
    "status": {
      "type": "string",
      "enum": [
        "Confirmed",
        "Potential Issue - Requires Verification",
        "False Positive",
        "Fixed",
        "Partially Fixed",
        "Not Fixed",
        "Accepted Risk"
      ]
    },
    "category": { "type": "string" },
    "cwe": { "type": "string" },
    "owasp": { "type": "string" },
    "asvs": { "type": "string" },
    "capec": { "type": "string" },
    "cvss": {
      "type": "object",
      "properties": {
        "score": { "type": "number" },
        "vector": { "type": "string" }
      },
      "additionalProperties": true
    },
    "affectedLocations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file"],
        "properties": {
          "file": { "type": "string" },
          "function": { "type": "string" },
          "startLine": { "type": "integer" },
          "endLine": { "type": "integer" }
        },
        "additionalProperties": false
      }
    },
    "description": { "type": "string" },
    "evidence": {
      "type": "array",
      "items": { "type": "string" }
    },
    "sourceToSink": {
      "type": "object",
      "properties": {
        "source": { "type": "string" },
        "transformations": {
          "type": "array",
          "items": { "type": "string" }
        },
        "validation": { "type": "string" },
        "authorization": { "type": "string" },
        "sink": { "type": "string" },
        "impact": { "type": "string" }
      },
      "additionalProperties": false
    },
    "exploitability": { "type": "string" },
    "attackScenario": { "type": "string" },
    "impact": { "type": "string" },
    "likelihood": {
      "type": "string",
      "enum": ["High", "Medium", "Low", "Unknown"]
    },
    "remediation": { "type": "string" },
    "secureExample": { "type": "string" },
    "references": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
